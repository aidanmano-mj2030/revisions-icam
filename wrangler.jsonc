{
  "name": "studicam",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  // Pas d'adresse en .workers.dev : le site s'ouvre seulement par studicam.pages.dev (dossier pages/).
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "studicam",
      "database_id": "d10caf2e-e345-4ff4-b038-c64512de777e",
      "migrations_dir": "migrations"
    }
  ],
  // Connexion Google. L'identifiant client est public ; le secret est rangé à part avec
  // `npx wrangler secret put GOOGLE_CLIENT_SECRET` (et dans .dev.vars pour le test local).
  "vars": {
    "GOOGLE_CLIENT_ID": "815727012676-53222kn5tkji2rb52na64qghu9fdg5pb.apps.googleusercontent.com"
  },
  // Limites de débit : connexions par IP (large, l'école partage une IP),
  // écritures de progression par élève, routes /api/prof/... par utilisateur.
  "ratelimits": [
    { "name": "LIMITE_CONNEXION", "namespace_id": "1001", "simple": { "limit": 300, "period": 60 } },
    { "name": "LIMITE_ECRITURE", "namespace_id": "1002", "simple": { "limit": 60, "period": 60 } },
    { "name": "LIMITE_PROF", "namespace_id": "1003", "simple": { "limit": 120, "period": 60 } }
  ]
}
